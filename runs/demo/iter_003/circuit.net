# Butterfly (bowtie) radial stub - 1-port shunt bias-decoupling test circuit
# Two MRSTUB "wings" tied to the same node model the symmetric butterfly/bowtie
# fan shape as two parallel 1-port radial-stub admittances (circuit-level
# approximation; verify with full-wave EM before fabrication).
Pac:P1 nodeA gnd Num="1" Z="50 Ohm" P="0 dBm" f="5000000000.0Hz"
MLIN:MLc nodeA nodeB Subst="Subst1" W="0.6mm" L="3.0mm" Model="Hammerstad" DispModel="Kirschning"
MRSTUB:MSW1 nodeB Subst="Subst1" ri="0.3mm" ro="3.1664mm" Wf="0.6mm" alpha="90.0" EffDimens="OldQucsNoCorrection" Model="OldQucsModel"
MRSTUB:MSW2 nodeB Subst="Subst1" ri="0.3mm" ro="3.1664mm" Wf="0.6mm" alpha="90.0" EffDimens="OldQucsNoCorrection" Model="OldQucsModel"
.SP:SP1 Type="lin" Start="1000000000.0Hz" Stop="10000000000.0Hz" Points="181" Noise="no" NoiseIP="1" NoiseOP="2" saveCVs="no" saveAll="no"
SUBST:Subst1 er="3.38" h="0.508mm" t="0.035mm" tand="0.0027" rho="1.72e-08" D="1.5e-07"
